# =============================================================================
# SmartMart Motors – Environment Variables
# Copy to .env.local and fill in real values. Never commit secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="SmartMart Motors"
NEXT_PUBLIC_SITE_TAGLINE="Best Electric Tricycle for Your Needs"
NEXT_PUBLIC_SITE_PHONE="0317506660"
NEXT_PUBLIC_SITE_EMAIL="smartmartmotors@gmail.com"
NEXT_PUBLIC_SITE_WHATSAPP="94775475141"
NEXT_PUBLIC_SITE_ADDRESS="Colombo, Sri Lanka"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/smartmartmotors"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/smartmartmotors"
NEXT_PUBLIC_YOUTUBE_URL=""

# Database (Supabase + Vercel)
# IMPORTANT on Vercel: use Transaction pooler (port 6543) with pgbouncer=true
# Supabase → Connect → ORMs → Prisma → Transaction pooler
# connection_limit=5 lets parallel queries on a page actually run in parallel;
# with connection_limit=1 every Promise.all is serialised one query at a time.
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=15"
# Optional direct URL for local migrations (db push / migrate)
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres"

# Admin bootstrap (local seed / password rotation only — never commit real values)
# SEED_ADMIN_PASSWORD="choose-a-strong-password-min-12-chars"
# ADMIN_PASSWORD="same-or-new-strong-password-for-rotate-script"

# NextAuth v5
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# AUTH_URL is preferred by Auth.js v5
AUTH_URL="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-only — bypasses RLS; never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Used when Cloudinary is not configured (run supabase/migrations/002_storage_bucket.sql)
SUPABASE_STORAGE_BUCKET="smartmart-media"

# Cloudinary (optional — if omitted, uploads use Supabase Storage instead)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_FOLDER="smartmart-motors"

# Analytics (optional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_CLARITY_ID=""
NEXT_PUBLIC_FB_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=""

# Feature flags
NEXT_PUBLIC_ENABLE_ANALYTICS="false"

# Docker build (optional)
# DOCKER_BUILD="1"
